@model IEnumerable<SmartHealthcare.Core.ViewModels.UserRoleViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-people-fill me-2"></i> User Management
        </h2>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-house-door"></i> Home
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col"><i class="bi bi-person-badge"></i> Full Name</th>
                        <th scope="col"><i class="bi bi-envelope"></i> Email</th>
                        <th scope="col"><i class="bi bi-shield-lock"></i> Role</th>
                        <th scope="col"><i class="bi bi-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int count = 1;
                        foreach (var user in Model)
                        {
                            <tr>
                                <td>@count</td>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge bg-@(user.Role == "Admin" ? "danger" : user.Role == "Doctor" ? "info" : user.Role == "Patient" ? "success" : "secondary")">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" disabled>
                                            <i class="bi bi-lock"></i> Fixed
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-action="AssignRole" asp-route-userId="@user.UserId" class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil-square"></i> Assign / Change Role
                                        </a>
                                    }
                                </td>
                            </tr>
                            count++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
